# This repository lives inside a real game installation. Track only our work.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/CURRENT_ISSUES.md
!/requirements-dev.txt
!/docs/
!/tools/
!/.github/
!/PersonalAddons/
!/_forever_/
/_forever_/*
!/_forever_/Interface/
/_forever_/Interface/*
!/_forever_/Interface/AddOns/
/_forever_/Interface/AddOns/*
!/_forever_/Interface/AddOns/MyForever*/

# Credentials, player data, local environments, generated files.
.DS_Store
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
**/WTF/
**/SavedVariables/
**/Logs/
**/Screenshots/
**/.MyForeverManager/
**/.venv/
**/venv/
**/__pycache__/
*.pyc
*.pyo
**/bin/
**/obj/
**/artifacts/
**/.taste-skill/
*.db
*.db-shm
*.db-wal
*.sqlite*
*.log
*.zip
*.tar.gz
*.dmg
*.dmp
*.dll
*.dylib
*.pdb
*.exe
*.app/

# Historical backups and private evidence remain on the original machine.
/PersonalAddons/backups/
/PersonalAddons/dist/
/PersonalAddons/local-logs/
/PersonalAddons/COACH-LIVE-REPORT.*
/PersonalAddons/COACH-VALIDATION.json
/PersonalAddons/Manager/SOURCE-SHA256.json
/PersonalAddons/website/private-captures/
/PersonalAddons/website/ops/*.png
/PersonalAddons/website/ops/*.jpg
/PersonalAddons/website/ops/community-release/
/PersonalAddons/website/ops/deployment-result.json
/PersonalAddons/design/**/tmp/
/PersonalAddons/design/**/qa/*.png

# Frozen website copies and SDKs are reproducible, not additional products.
/PersonalAddons/work/*-site/
/PersonalAddons/work/*-dotnet/
/PersonalAddons/work/coach-validation/
/PersonalAddons/work/behavior-validation/*.json

# Downloaded reference implementations are not our source. Keep our reports,
# provenance and small data generators; install upstream addons separately.
/PersonalAddons/research/*/*
!/PersonalAddons/research/*/*.md
!/PersonalAddons/research/*/*.json
!/PersonalAddons/research/*/*.py
!/PersonalAddons/research/navigator/*LICENSE*
!/PersonalAddons/research/navigator/*sha.txt
/PersonalAddons/work/gather-recovery/nodesight*/
/PersonalAddons/work/gather-recovery/native-audit/Blizzard*/

# Temporary preview renders / runtime captures may contain player information.
/PersonalAddons/work/**/*.png
/PersonalAddons/work/**/*.jpg
/PersonalAddons/work/**/*.jpeg
/PersonalAddons/work/**/runtime*.json
/PersonalAddons/work/**/live-*.json
/PersonalAddons/work/**/native-*.json
/PersonalAddons/work/**/state.json
/PersonalAddons/work/**/status-before*.json
/PersonalAddons/work/**/screenshots/
