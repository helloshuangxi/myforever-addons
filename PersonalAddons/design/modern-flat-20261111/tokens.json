{
  "name": "我的无限 · 静石",
  "version": "1.2-design-proposal",
  "date": "2026-11-11",
  "status": "design-proposal-not-implemented",
  "units": "WoW logical pixels; final scaling requires client validation",
  "runtimeLibrary": false,
  "direction": {
    "name": "Apple-inspired native utility + WoW HUD",
    "principles": ["gameplay-first-clearance", "native-tool-not-web-dashboard", "simplicity", "hierarchy", "preserve-context", "predictable-consistency", "small-unobtrusive-HUDs"],
    "nativePatterns": ["small-titlebar", "concise-toolbar", "segmented-controls", "whole-row-selection", "contextual-inspector", "contextual-popover"],
    "avoid": ["website-hero", "persistent-suite-sidebar", "feature-card-grid", "large-KPIs", "cross-addon-dashboard", "macOS-traffic-lights", "oversized-iOS-controls", "strong-glass", "assumed-real-time-background-blur"],
    "adaptationNotAppleNativeComponents": true,
    "noBundledSFFontsOrSFSymbols": true,
    "references": [
      "https://developer.apple.com/design/human-interface-guidelines/design-principles/",
      "https://developer.apple.com/design/human-interface-guidelines/panels",
      "https://developer.apple.com/design/human-interface-guidelines/toolbars",
      "https://developer.apple.com/design/human-interface-guidelines/designing-for-games"
    ]
  },
  "screenPriority": {
    "principleOne": "keep-gameplay-view-clean-show-addons-on-demand",
    "policyStatus": "proposed-defaults-not-applied",
    "preserveExistingUserVisibilityPositionSizeAndAlerts": true,
    "centralClearanceReference": {"widthFraction": 0.4, "heightFraction": 0.55, "placement": "center", "adjustable": true, "autoMoveExistingUI": false},
    "avoidNative": ["minimap", "quest-tracker", "target-frame", "action-bars", "cast-bars"],
    "modes": ["game-default", "user-expanded", "transient-alert", "combat"],
    "noPersistentSuiteNavigation": true,
    "galleryNavigationIsDesignBrowserOnly": true,
    "noSimultaneousAutomaticMainWindows": true,
    "neverStealInputFocus": true,
    "criticalUnresolvedStateRemainsVisible": true,
    "proposedAddonDefaults": {
      "MyForeverChat": "main-window-on-demand; necessary-single-line-whisper-alert-without-body; no-per-channel-message-popup",
      "MyForeverProfessions": "hidden-or-collapsed; transient-name-only-for-confirmed-new-resource; preserve-sound-and-sparkle-settings",
      "MyForeverNavigator": "hide-when-navigation-inactive; show-300x84-HUD-only-when-active",
      "MyForeverTargets": "only-user-needed-friendly-and-enemy-groups; preserve-existing-secure-combat-visibility-mechanisms",
      "MyForeverMacros": "main-window-user-opened-and-closed; preserve-seal-alert-settings",
      "MyForeverFieldKit": "hidden; optional-compact-single-line-enabled-by-user",
      "MyForeverCoach": "main-window-user-opened-and-closed; hiding-does-not-pause-capture"
    }
  },
  "transientNotifications": {
    "maxVisible": 1,
    "suggestedDurationMs": {"min": 2000, "max": 3000},
    "mergeSameKind": true,
    "durationStatus": "proposal-requires-client-validation",
    "preserveExistingAlertSoundAndSparkleSettings": true,
    "dismissalDoesNotResolveUnderlyingState": true
  },
  "colors": {
    "background": "#111214",
    "panel": "#222326",
    "raised": "#303236",
    "hover": "#3A3D42",
    "line": "#4B4F56",
    "textPrimary": "#F5F5F7",
    "textSecondary": "#C0C3C9",
    "textMuted": "#969BA5",
    "brand": "#8BBEF3",
    "onBrand": "#132335",
    "primaryFill": "#0A64C5",
    "onPrimary": "#FFFFFF",
    "success": "#79D7BE",
    "specialtyGold": "#E2C183",
    "warning": "#F2C46D",
    "danger": "#F28B82",
    "info": "#8DBFF2"
  },
  "opacity": {
    "status": "design-proposal-not-applied-to-addons",
    "convention": "alpha-is-opacity; transparency-percent=(1-alpha)*100",
    "labelsShowBothOpacityAndTransparency": true,
    "allAddonPanelsUseAssignedRole": true,
    "implementation": "background-texture-RGBA-only; never-global-parent-Frame-SetAlpha",
    "roles": {
      "toolWindow": {"alpha": 0.84, "opacityPercent": 84, "transparencyPercent": 16, "userAlphaMin": 0.72, "userAlphaMax": 0.94},
      "compactHUD": {"alpha": 0.72, "opacityPercent": 72, "transparencyPercent": 28, "userAlphaMin": 0.6, "userAlphaMax": 0.9},
      "transientAlert": {"alpha": 0.8, "opacityPercent": 80, "transparencyPercent": 20, "userAlphaMin": 0.7, "userAlphaMax": 0.92},
      "popover": {"alpha": 0.9, "opacityPercent": 90, "transparencyPercent": 10, "userAlphaMin": 0.82, "userAlphaMax": 0.96}
    },
    "addonRoles": {
      "MyForeverChat": {"conversation": "toolWindow", "necessaryMessageAlert": "transientAlert", "appearanceAndContext": "popover"},
      "MyForeverProfessions": {"professionPanel": "toolWindow", "confirmedNewResourceAlert": "transientAlert", "settingsAndDetail": "popover"},
      "MyForeverNavigator": {"destinationBrowser": "toolWindow", "activeNavigation": "compactHUD", "context": "popover"},
      "MyForeverTargets": {"friendlyAndEnemyGroups": "toolWindow", "markerAndContext": "popover"},
      "MyForeverMacros": {"editor": "toolWindow", "sealAlert": "transientAlert", "spellPickerAndContext": "popover"},
      "MyForeverFieldKit": {"expanded": "toolWindow", "optionalCompactLine": "compactHUD", "context": "popover"},
      "MyForeverCoach": {"capabilityAndExport": "toolWindow", "appearanceAndContext": "popover"}
    },
    "foregroundAlpha": 1,
    "foregroundIncludes": ["text", "icons", "item-links", "health-bars", "current-target-indicator", "focus-indicator"],
    "ordinaryBorderAlpha": 0.55,
    "importantTargetAndFocusBorderAlpha": 1,
    "nestedBackgrounds": "lightweight-regions; avoid-stacking-to-opaque-cards",
    "busyOrBrightBackgroundFallbacks": ["local-text-backplate", "user-raises-background-alpha-within-role-range"],
    "noAutomaticBackgroundRecognitionOrAdjustment": true,
    "noFullTransparency": true,
    "noRealTimeBlurPromise": true,
    "preserveExistingUserVisibilitySoundAndSparkleSettings": true,
    "staticSwatchContrastIsNotCompositeSceneGuarantee": true,
    "validationScenes": ["dark", "light", "complex"],
    "validateAlphaValues": ["default", "user-minimum", "user-maximum"]
  },
  "semanticRules": {
    "preserveNative": ["item-rarity", "class", "reaction", "profession-difficulty", "chat-channel", "raid-marker"],
    "preserveAddonTargetSemantics": {"currentTarget": "red-outline-and-current-label", "focus": "yellow-outline-and-focus-label", "canOverlap": true},
    "brandUsage": ["selected-indicator", "keyboard-focus", "addon-normal-link"],
    "primaryUsage": ["explicit-primary-action"],
    "successUsage": ["completed-result", "success-state"],
    "statusNeedsTextOrShape": true,
    "unknownValue": "—",
    "knownZero": "0"
  },
  "spacing": {"unit": 4, "scale": [4, 8, 12, 16, 24]},
  "radii": {"panel": 6, "control": 4, "listRow": 2, "itemIcon": 2},
  "typography": {
    "family": "client-provided authorized Chinese font; no bundled SF fonts",
    "outline": "none",
    "title": 16,
    "keyResult": {"min": 18, "max": 20},
    "body": 13,
    "secondary": 12,
    "compactMinimum": 11,
    "maxKeyResultsPerWindow": 1,
    "numericAlignment": "right; tabular figures only if supported"
  },
  "dimensions": {
    "headerHeight": 36,
    "toolbarHeight": 32,
    "rowHeight": 34,
    "detailRowMinHeight": 44,
    "inputHeight": 30,
    "buttonHeight": 28,
    "primaryButtonHeight": 32,
    "iconButtonHitArea": 28,
    "targetTile": 56,
    "panelPadding": 12,
    "denseGridPadding": {"min": 4, "max": 8},
    "functionalIconCanvas": 24,
    "functionalIconStroke": 1.5
  },
  "motion": {
    "feedbackMs": {"min": 100, "max": 160},
    "reducedMotion": "immediate-state-change",
    "continuousDecorativeAnimation": false,
    "listRefreshFlash": false
  },
  "accessibilityTargets": {
    "bodyAndButtonTextContrastMinimum": 4.5,
    "statusColorOnly": false,
    "iconButtonsNeedTooltipOrName": true,
    "keyboardFocusVisible": true
  },
  "scope": ["MyForeverChat", "MyForeverProfessions", "MyForeverNavigator", "MyForeverTargets", "MyForeverMacros", "MyForeverFieldKit", "MyForeverCoach"],
  "constraints": [
    "independent-addon-loading",
    "no-global-native-or-third-party-reskin",
    "preserve-existing-user-settings",
    "preserve-accepted-professions-resize-and-spellbook-entry",
    "no-secure-action-or-combat-behavior-changes-from-theming",
    "gameplay-clearance-does-not-authorize-moving-user-ui-or-changing-secure-visibility",
    "no-new-resource-directions-or-navigation",
    "no-public-release-implied"
  ]
}
